table FactVenta
	lineageTag: d948ffb5-1498-5e52-a844-ac69380a6ba3

	/// Venta documental recibida neta sin IGV, luego de deduplicación y precedencia ERP. Puede ser parcial; no es cierre oficial.
	measure 'Venta recibida' = SUM ( FactVenta[venta] )
		formatString: "S/ "#,0.00
		displayFolder: 01 Resultado
		lineageTag: e2650b96-80f4-56f0-b098-651f9b725994

	/// Meses del contexto; universo enero-junio 2026.
	measure 'Meses seleccionados' = COUNTROWS ( VALUES ( DimMes[periodo] ) )
		formatString: 0
		isHidden
		displayFolder: 04 Contexto
		lineageTag: 2d964e8f-e97f-597b-97e8-677114230f37

	/// Meses seleccionados sin cabecera y líneas completas. No baja al filtrar cliente/asesor.
	measure 'Meses pendientes' = COUNTROWS ( FILTER ( VALUES ( DimMes[periodo] ), CALCULATE ( MAX ( DimMes[completo] ) ) = 0 ) )
		formatString: 0
		displayFolder: 04 Contexto
		lineageTag: ef218240-0671-58e4-8041-85f0eccf6c22

	/// Completitud de fuentes del contexto; no implica Desktop validado ni aceptación humana.
	measure 'Estado de cobertura' = IF ( [Meses seleccionados] = 0, "Sin período", IF ( [Meses pendientes] > 0, "PARCIAL · falta entrega", "COMPLETO · fuentes recibidas" ) )
		displayFolder: 04 Contexto
		lineageTag: 69d12427-73ab-5bf0-8d45-191b47a3f80b

	/// Ajuste financiero sin reparto. Sólo aplica bajo filtros de mes; BLANK por cliente, producto o cualquier asesor.
	measure 'Ajustes de cierre' = IF ( ISCROSSFILTERED ( DimCliente ) || ISCROSSFILTERED ( DimProducto ) || ISCROSSFILTERED ( DimAsesorHistorico ) || ISCROSSFILTERED ( DimAsesorActual ), BLANK (), SUM ( FactAjuste[ajuste] ) )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: b828098d-2912-5926-a64b-5d2de0e0a866

	/// Cierre: venta recibida + ajuste permitido por ámbito. BLANK si cualquier mes seleccionado falta. Bajo asesor/producto/cliente conserva venta atribuida y explica ajuste excluido.
	measure 'Venta oficial' = IF ( [Meses seleccionados] > 0 && [Meses pendientes] = 0, IF ( ISBLANK ( [Venta recibida] ) && ISBLANK ( [Ajustes de cierre] ), BLANK (), COALESCE ( [Venta recibida], 0 ) + COALESCE ( [Ajustes de cierre], 0 ) ), BLANK () )
		formatString: "S/ "#,0.00
		displayFolder: 01 Resultado
		lineageTag: ea66fcc6-a208-5dfe-a1e9-8031e283eafb

	/// Costo de líneas del mismo grano/contexto de venta; nunca suma costo de cabecera.
	measure 'Costo recibido' = SUM ( FactVenta[costo] )
		formatString: "S/ "#,0.00
		displayFolder: 01 Resultado
		lineageTag: 58e2b7f2-61b7-5f94-b90f-494b309e91fc

	/// Costo recibido + costo del ajuste sólo en ámbito compatible; BLANK por cobertura incompleta.
	measure 'Costo oficial' = IF ( [Meses seleccionados] > 0 && [Meses pendientes] = 0, [Costo recibido] + IF ( ISCROSSFILTERED ( DimCliente ) || ISCROSSFILTERED ( DimProducto ) || ISCROSSFILTERED ( DimAsesorHistorico ) || ISCROSSFILTERED ( DimAsesorActual ), 0, COALESCE ( SUM ( FactAjuste[costo_ajuste] ), 0 ) ), BLANK () )
		formatString: "S/ "#,0.00
		isHidden
		displayFolder: 01 Resultado
		lineageTag: 9876fa08-345e-566d-a24c-6298aa4a441e

	/// Venta oficial menos costo oficial bajo el mismo ámbito. No mostrar margen oficial de cobertura parcial.
	measure 'Margen oficial' = IF ( ISBLANK ( [Venta oficial] ), BLANK (), [Venta oficial] - [Costo oficial] )
		formatString: "S/ "#,0.00
		displayFolder: 01 Resultado
		lineageTag: 10c0af43-5395-59a9-9031-dbd4101a0637

	/// Margen total / venta total del contexto; no suma ni promedia porcentajes de líneas. Venta cero: BLANK.
	measure 'Margen %' = DIVIDE ( [Margen oficial], [Venta oficial] )
		formatString: 0.0%
		displayFolder: 01 Resultado
		lineageTag: 06bf65e8-f6f5-5fc1-aa71-b22380e4a08b

	/// Meta mensual por asesor histórico: base×factor HALF_UP. No aplicable por cliente, producto o cartera actual; no distribuir artificialmente.
	measure 'Meta comercial' = IF ( ISCROSSFILTERED ( DimCliente ) || ISCROSSFILTERED ( DimProducto ) || ISCROSSFILTERED ( DimAsesorActual ), BLANK (), SUM ( FactMeta[meta] ) )
		formatString: "S/ "#,0.00
		displayFolder: 03 Metas
		lineageTag: 0dee5d39-4e06-5c69-96ae-561460b1834c

	/// Venta oficial / meta aplicable recalculado en total; BLANK por cobertura incompleta o ámbito no compatible.
	measure Cumplimiento = DIVIDE ( [Venta oficial], [Meta comercial] )
		formatString: 0.0%
		displayFolder: 03 Metas
		lineageTag: 81247ce9-f885-5c40-8821-ad86b6f74ec2

	/// Meta menos venta oficial. Positivo indica venta faltante; no equivale a forecast.
	measure 'Brecha a meta' = IF ( ISBLANK ( [Venta oficial] ) || ISBLANK ( [Meta comercial] ), BLANK (), [Meta comercial] - [Venta oficial] )
		formatString: "S/ "#,0.00
		displayFolder: 03 Metas
		lineageTag: 03f62ee3-04ca-5b41-a24a-6c9d253b86ec

	/// Explica por qué no se evalúa meta/cumplimiento, sin representar BLANK como cero.
	measure 'Aplicación de meta' = IF ( ISCROSSFILTERED ( DimCliente ) || ISCROSSFILTERED ( DimProducto ) || ISCROSSFILTERED ( DimAsesorActual ), "META NO APLICABLE · ámbito", IF ( [Meses pendientes] > 0, "CUMPLIMIENTO PENDIENTE · fuentes", "Meta por mes / asesor histórico" ) )
		displayFolder: 04 Contexto
		lineageTag: 04347e22-072c-5b16-8278-6ef041ea34b6

	/// Legacy luego de clave vacía/deduplicación; incluye líneas sustituidas para el puente.
	measure 'Legacy válido único' = SUM ( FactVenta[legacy_base] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: 97d86f55-e3bb-5eab-bdb5-ad2298083235

	/// Nuevas líneas recibidas incluida última semana marzo; cabeceras sólo controlan.
	measure 'ERP nuevo recibido' = SUM ( FactVenta[nuevo_base] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: ef08a9b1-2d94-5720-8862-52391e21d4e5

	/// Legacy retirado por mismo negocio cuando ERP nuevo prevalece; restar del puente.
	measure 'Legacy sustituido' = SUM ( FactVenta[legacy_sustituido] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: 9c3a52c8-e958-5f89-990a-b86ad0101e34

	/// Diferencia nuevo−legacy de operaciones repetidas; no se suma otra vez al puente.
	measure 'Corrección de migración' = SUM ( FactVenta[correccion_migracion] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: 88229ef9-d13a-5c1d-a80a-a540985ee0c6

	/// Legacy válido + nuevo recibido − legacy sustituido. Debe igualar venta recibida. Sin filas recibidas: BLANK.
	measure 'Puente documental' = IF ( ISBLANK ( [Venta recibida] ), BLANK (), [Legacy válido único] + [ERP nuevo recibido] - [Legacy sustituido] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: f3c0c63d-0db8-51db-a790-a748ff4a20ee

	/// Diferencia independiente de visuales: cero con datos válidos, BLANK sin filas recibidas. No prueba DAX runtime hasta consultar motor.
	measure 'Diferencia de puente' = IF ( ISBLANK ( [Venta recibida] ), BLANK (), [Puente documental] - [Venta recibida] )
		formatString: "S/ "#,0.00
		displayFolder: 02 Conciliación
		lineageTag: fa26fe2b-b1ef-5130-8cf0-f7d47a31d4f5

	/// Negocios únicos recibidos luego de precedencia; no contar dos sistemas como dos ventas.
	measure 'Documentos recibidos' = DISTINCTCOUNT ( FactVenta[business_id] )
		formatString: #,0
		displayFolder: 04 Contexto
		lineageTag: ca2976b2-91d8-5047-8ae6-06a726e57a17

	/// Grano único de línea documental canónica en mart.
	measure 'Líneas recibidas' = COUNTROWS ( FactVenta )
		formatString: #,0
		isHidden
		displayFolder: 04 Contexto
		lineageTag: 21c0f4fc-a6d3-5529-8804-3b6bf9f744b3

	/// Ventas con asesor histórico desconocido; incluidas en venta recibida, separadas de asesores identificados.
	measure 'Venta sin historia' = CALCULATE ( [Venta recibida], KEEPFILTERS ( FactVenta[sin_historia] = 1 ) )
		formatString: "S/ "#,0.00
		displayFolder: 04 Contexto
		lineageTag: baa413bc-1c45-5999-a499-f7582ff7398f

