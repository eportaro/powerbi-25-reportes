	partition DimMes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimMes.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"periodo", type text}, {"mes", Int64.Type}, {"nombre", type text}, {"completo", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

