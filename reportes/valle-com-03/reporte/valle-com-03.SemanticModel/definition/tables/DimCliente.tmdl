	partition DimCliente = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimCliente.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"cliente_id", type text}, {"nombre", type text}}, "en-US")
