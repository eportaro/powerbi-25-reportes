table FactInventario
	lineageTag: 3db8dabb-8539-55ff-97e0-149d192826c4

	/// Saldo físico oficial del único corte en unidades base.
	measure 'Saldo unidades' = SUM ( FactInventario[saldo_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 563f491a-0c3c-5dd4-a377-e04edb671479

	/// Reservas ACTIVA al corte; no modifica el saldo.
	measure 'Reserva activa' = SUM ( FactInventario[reserva_activa_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 0779ed51-bc1b-5caf-bc5e-20ae7bceec34

	/// Incidencias ABIERTA incluidas físicamente en saldo y distintas de reservas.
	measure 'Bloqueo abierto' = SUM ( FactInventario[bloqueo_abierto_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 7ecc204b-994d-5014-b6cc-62a4c84e7731

	/// Saldo menos reservas activas y bloqueo abierto; conserva negativos.
	measure 'Disponible neto' = SUM ( FactInventario[neto_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 318ff644-1893-51b3-9e31-6762cd2cacfb

	/// Suma del máximo(neto,0) calculado por SKU/almacén/corte, nunca clamp del total.
	measure 'Disponible prometible' = SUM ( FactInventario[prometible_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 97692a70-35bd-541f-9edb-c1f511166c05

	/// Suma del máximo(-neto,0) por SKU/almacén/corte.
	measure 'Faltante unidades' = SUM ( FactInventario[faltante_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: da9cea26-ecd1-54cf-90ce-98d20f4be51a

	/// Suma de mínimos válidos convertidos a unidad base; políticas ausentes permanecen BLANK.
	measure 'Mínimo unidades' = SUM ( FactInventario[minimo_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 1950bf4c-a2bc-5626-b3de-f3094fbc368f

	/// Referencia de planificación convertida a unidad base; no es una orden automática.
	measure 'Objetivo unidades' = SUM ( FactInventario[objetivo_base] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: cf0520fc-76e5-54c7-a698-b5c3d8916578

	/// Cuenta SKU/almacén con prometible estrictamente menor al mínimo; sin política no evaluable.
	measure 'Combinaciones en alerta' = SUM ( FactInventario[alerta_flag] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 4bec445c-f7f4-5623-bcc6-7a5c0d69c943

	/// Combinaciones con política ausente, inválida, ambigua o fuera de vigencia.
	measure 'Políticas por revisar' = SUM ( FactInventario[politica_revisar_flag] )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: c3e89f68-2ab7-52d0-bf8f-86d42f5fb7b3

	/// Itera cada SKU/almacén/corte: saldo físico por costo promedio oficial y redondeo a céntimos por fila antes de sumar. PEN sin IGV; Currency conserva 4 decimales.
	measure 'Valor stock' = SUMX ( FactInventario, ROUND ( FactInventario[saldo_base] * FactInventario[costo_promedio_pen], 2 ) )
		formatString: "S/ "#,0.00
		displayFolder: Inventario
		lineageTag: f6e116cc-a995-5324-a9aa-36f414f17789

	/// Conteo de combinaciones visibles del único corte.
	measure 'Combinaciones inventario' = COUNTROWS ( FactInventario )
		formatString: #,0
		displayFolder: Inventario
		lineageTag: 1c11f5ea-8e15-5629-8f66-40ef7e2b2709

	/// Alertas entre combinaciones con política válida; DIVIDE devuelve BLANK si denominador vacío/cero.
	measure '% combinaciones en alerta' = DIVIDE ( [Combinaciones en alerta], SUM ( FactInventario[politica_valida_flag] ) )
		formatString: 0.0%
		displayFolder: Inventario
		lineageTag: 66f5cc7f-a4ce-5ccd-bd5d-35a4126daf88

	/// Nivel 1 faltante; 2 prometible cero; 3 bajo mínimo; 4 resto válido. Sin política y sin nivel 1/2, BLANK. Solo detalle SKU/almacén.
	measure 'Prioridad revisión' = IF ( HASONEVALUE ( DimArticulo[sku] ) && HASONEVALUE ( DimAlmacen[almacen] ), SELECTEDVALUE ( FactInventario[prioridad] ), BLANK () )
		formatString: #,0
		displayFolder: Revisión
		lineageTag: d369ecfc-2823-555f-ae10-2e425eebe185

	/// Orden global al corte por prioridad, faltante*costo descendente, SKU/almacén ascendentes. Prioridad pendiente de revisión al final.
	measure 'Orden revisión' = IF ( HASONEVALUE ( DimArticulo[sku] ) && HASONEVALUE ( DimAlmacen[almacen] ), SELECTEDVALUE ( FactInventario[orden_revision] ), BLANK () )
		formatString: #,0
		displayFolder: Revisión
		lineageTag: f38ccb8c-d3b3-5f52-8fa7-f385281f47ca

	column sku
		dataType: string
		isHidden
