	partition FactInventario = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactInventario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"sku", type text}, {"almacen", type text}, {"fecha_corte", type date}, {"saldo_base", Int64.Type}, {"reserva_activa_base", Int64.Type}, {"bloqueo_abierto_base", Int64.Type}, {"neto_base", Int64.Type}, {"prometible_base", Int64.Type}, {"faltante_base", Int64.Type}, {"costo_promedio_pen", Currency.Type}, {"valor_stock_pen", Currency.Type}, {"valor_faltante_pen", Currency.Type}, {"minimo_base", Int64.Type}, {"objetivo_base", Int64.Type}, {"alerta_flag", Int64.Type}, {"politica_valida_flag", Int64.Type}, {"politica_revisar_flag", Int64.Type}, {"prioridad", Int64.Type}, {"prioridad_revision", Int64.Type}, {"orden_revision", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

