table FactCompra
	lineageTag: c29c49cf-5bea-50cc-82c7-c236acfe5f19

	/// Líneas CONFIRMADA con pendiente positivo: pedido menos recepciones CONTABILIZADA hasta corte inclusive. No se agrega al stock.
	measure 'Compra pendiente' = SUM ( FactCompra[pendiente_base] )
		formatString: #,0
		displayFolder: Abastecimiento
		lineageTag: 54ebbf2e-51c4-59e8-a16e-d3b4da16e32c

	/// Itera líneas pendientes confirmadas; fecha prometida estrictamente menor al corte. Igual al corte no atrasada; sin fecha no inferir atraso.
	measure 'Compra atrasada' = SUMX ( FactCompra, FactCompra[pendiente_base] * FactCompra[atrasada_flag] )
		formatString: #,0
		displayFolder: Abastecimiento
		lineageTag: 484ee3e4-3fa3-5e0c-8179-64ec3dbfedec

	/// Conteo de líneas confirmadas pendientes al corte, independiente del hecho de inventario.
	measure 'Líneas compra pendientes' = COUNTROWS ( FactCompra )
		formatString: #,0
		displayFolder: Abastecimiento
		lineageTag: 7aaa7ff7-3797-57ff-8a16-cb19048fe0dd

	/// Líneas pendientes con fecha prometida por confirmar; no se clasifican atrasadas automáticamente.
	measure 'Líneas sin fecha' = SUM ( FactCompra[fecha_por_confirmar_flag] )
		formatString: #,0
		displayFolder: Abastecimiento
		lineageTag: 353e27ad-b966-5880-a500-c604bbe5f1ae

