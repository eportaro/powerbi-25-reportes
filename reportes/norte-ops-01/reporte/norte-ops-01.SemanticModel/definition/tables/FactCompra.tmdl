	partition FactCompra = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactCompra.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"pedido_compra", type text}, {"linea", Int64.Type}, {"sku", type text}, {"almacen", type text}, {"fecha_corte", type date}, {"proveedor", type text}, {"fecha_prometida", type date}, {"pedida_base", Int64.Type}, {"recibida_base", Int64.Type}, {"pendiente_base", Int64.Type}, {"atrasada_flag", Int64.Type}, {"fecha_por_confirmar_flag", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

