	partition FilaPyG = calculated
		mode: import
		source =
				DATATABLE (
					"orden", INTEGER, "clave", STRING, "fila", STRING, "nombre", STRING, "sentido", INTEGER,
					{
					{ 10, "PYG-10", "Ingresos por servicios", "Ingresos por servicios", 1 },
					{ 20, "PYG-20", "(−) Descuentos concedidos", "Descuentos concedidos", -1 },
					{ 30, "IN", "= Ingresos netos", "Ingresos netos", 1 },
					{ 40, "PYG-30", "(−) Costo del servicio", "Costo del servicio", -1 },
					{ 50, "MB", "= Margen bruto", "Margen bruto", 1 },
					{ 60, "PYG-40", "Gastos de personal administrativo", "Gastos de personal administrativo", -1 },
					{ 70, "PYG-50", "Gastos generales", "Gastos generales", -1 },
					{ 80, "PYG-60", "Publicidad y ventas", "Publicidad y ventas", -1 },
					{ 90, "PYG-70", "Depreciación", "Depreciación", -1 },
					{ 100, "PYG-99", "Por clasificar", "Por clasificar", -1 },
					{ 110, "GO", "(−) Gastos operativos", "Gastos operativos", -1 },
					{ 120, "RO", "= Resultado operativo", "Resultado operativo", 1 }
					}
				)

	annotation PBI_ResultType = Table

