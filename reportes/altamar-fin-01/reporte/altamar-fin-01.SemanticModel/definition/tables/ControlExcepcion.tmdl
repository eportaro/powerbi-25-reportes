	partition ControlExcepcion = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\ControlExcepcion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"excepcion_id", type text}, {"tipo", type text}, {"asiento", type text}, {"periodo", type text}, {"centro_costo", type text}, {"codigo_linea", type text}, {"importe_pen", Currency.Type}, {"tratamiento", type text}, {"fuente", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

