table ControlExcepcion
	lineageTag: 7767a6ec-6c12-59a2-ae91-45fa4d0d2e6f

	/// Registros de ControlExcepcion: lo excluido o mostrado aparte, con su tratamiento.
	measure Excepciones = COUNTROWS ( ControlExcepcion )
		formatString: #,0
		displayFolder: Control
		lineageTag: a8ed0054-8576-5948-9cdd-1219301c5810

	/// Importe declarado de las excepciones de un mismo tipo, en soles. Tipos distintos no forman un total.
	measure 'Importe excepciones' = SUM ( ControlExcepcion[importe_pen] )
		formatString: #,0
		displayFolder: Control
		lineageTag: bfd635d3-30f9-5afe-9a76-45263f4d9e06

