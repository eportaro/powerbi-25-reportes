table FactReal
	lineageTag: e31ca602-1d3c-5706-8cc9-8fae24577bbd

	/// Saldo por naturaleza de las cuentas de la página, asientos CONTABILIZADO de enero a septiembre.
	measure 'Real base' = SUM ( FactReal[importe_pen] )
		formatString: #,0.00
		isHidden
		displayFolder: Base
		lineageTag: d4c17633-b45b-589c-bcf7-d5678c2ac817

	/// Real de las celdas mes × línea × centro con presupuesto mensual V1.
	measure 'Real comparable base' = CALCULATE ( SUM ( FactReal[importe_pen] ), FactReal[comparable_flag] = 1 )
		formatString: #,0.00
		isHidden
		displayFolder: Base
		lineageTag: 45223f08-88b4-5fda-9f09-9cf639587c40

	column periodo
		dataType: string
		isHidden
		lineageTag: 3dc00dae-006f-5e04-935a-b57c74414d3f
		summarizeBy: none
		sourceColumn: periodo

		annotation SummarizationSetBy = Automatic

	column cuenta
