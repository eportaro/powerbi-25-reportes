	partition FactReal = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactReal.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"periodo", type text}, {"cuenta", type text}, {"codigo_linea", type text}, {"centro_costo", type text}, {"importe_pen", Currency.Type}, {"movimientos", Int64.Type}, {"comparable_flag", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

