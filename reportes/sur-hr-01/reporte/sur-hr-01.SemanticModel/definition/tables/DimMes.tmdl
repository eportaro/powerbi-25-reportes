	partition DimMes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimMes.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"periodo", type text}, {"mes", Int64.Type}, {"mes_nombre", type text}, {"fecha_inicio", type date}, {"fecha_fin", type date}}, "en-US")
