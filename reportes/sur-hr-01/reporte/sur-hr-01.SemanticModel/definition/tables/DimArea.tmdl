table DimArea
	lineageTag: a1d8245f-e950-5443-9238-8e8293392e1b

	column area_id
		dataType: string
		lineageTag: d7a746ea-002f-58ff-8785-b853cd0c9a24
		summarizeBy: none
		sourceColumn: area_id

		annotation SummarizationSetBy = Automatic

	column nombre
		dataType: string
		lineageTag: 363d98d7-69bc-5f75-aa3c-1f6c960b55db
		summarizeBy: none
		sourceColumn: nombre

		annotation SummarizationSetBy = Automatic

	partition DimArea = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimArea.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"area_id", type text}, {"nombre", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

