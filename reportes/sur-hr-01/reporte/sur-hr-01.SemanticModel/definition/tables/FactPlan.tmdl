table FactPlan
	lineageTag: 21501fd5-78cf-53a5-8222-0fb0c88412d5

	column periodo
		dataType: string
		isHidden
		lineageTag: 43d5cf9b-bcb3-5657-b336-5b9918055c22
		summarizeBy: none
		sourceColumn: periodo

		annotation SummarizationSetBy = Automatic

	column area_id
		dataType: string
		isHidden
		lineageTag: 3ffdd4f5-9782-57cc-8f35-8182d3742507
		summarizeBy: none
		sourceColumn: area_id

		annotation SummarizationSetBy = Automatic

	column sede_id
		dataType: string
