	partition FactPlan = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactPlan.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"periodo", type text}, {"area_id", type text}, {"sede_id", type text}, {"plan_personas", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

