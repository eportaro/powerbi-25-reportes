		dataType: decimal
		isHidden
		formatString: #,0.00
		lineageTag: 6f83321a-74d1-5a59-b03c-1f1fa98c056c
		summarizeBy: none
		sourceColumn: venta_pen

		annotation SummarizationSetBy = Automatic

	column devoluciones_pen
		dataType: decimal
		isHidden
		formatString: #,0.00
		lineageTag: a7dc97f2-8c17-52f2-824e-ad34c9bed13e
		summarizeBy: none
		sourceColumn: devoluciones_pen

		annotation SummarizationSetBy = Automatic

	column venta_neta_pen
		dataType: decimal
		isHidden
		formatString: #,0.00
		lineageTag: bae71088-c60a-5112-92b9-657f46322a0a
		summarizeBy: none
		sourceColumn: venta_neta_pen

		annotation SummarizationSetBy = Automatic

	column tickets
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c40206f0-c0ca-5e35-a612-19ecd402173a
		summarizeBy: none
		sourceColumn: tickets

		annotation SummarizationSetBy = Automatic

	column origen
		dataType: string
		isHidden
		lineageTag: a754d3ef-9a63-551f-b1c0-870622b0e6e3
		summarizeBy: none
		sourceColumn: origen

		annotation SummarizationSetBy = Automatic

	column sin_cierre_flag
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 16985041-a0bd-5f4a-8bf4-500903ef858d
		summarizeBy: none
		sourceColumn: sin_cierre_flag

		annotation SummarizationSetBy = Automatic

	partition FactVenta = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactVenta.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"fecha", type date}, {"unidad", type text}, {"venta_pen", Currency.Type}, {"devoluciones_pen", Currency.Type}, {"venta_neta_pen", Currency.Type}, {"tickets", Int64.Type}, {"origen", type text}, {"sin_cierre_flag", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

