expression Holidays = {#date(2024,1,1),#date(2024,3,28),#date(2024,3,29),#date(2024,5,1),#date(2024,6,7),#date(2024,6,29),#date(2024,7,23),#date(2024,7,28),#date(2024,7,29),#date(2024,8,6),#date(2024,8,30),#date(2024,10,8),#date(2024,11,1),#date(2024,12,8),#date(2024,12,9),#date(2024,12,25),#date(2025,1,1),#date(2025,4,17),#date(2025,4,18),#date(2025,5,1),#date(2025,6,7),#date(2025,6,29),#date(2025,7,23),#date(2025,7,28),#date(2025,7,29),#date(2025,8,6),#date(2025,8,30),#date(2025,10,8),#date(2025,11,1),#date(2025,12,8),#date(2025,12,9),#date(2025,12,25),#date(2026,1,1),#date(2026,4,2),#date(2026,4,3),#date(2026,5,1),#date(2026,6,7),#date(2026,6,29),#date(2026,7,23),#date(2026,7,28),#date(2026,7,29),#date(2026,8,6),#date(2026,8,30),#date(2026,10,8),#date(2026,11,1),#date(2026,12,8),#date(2026,12,9),#date(2026,12,25)}
