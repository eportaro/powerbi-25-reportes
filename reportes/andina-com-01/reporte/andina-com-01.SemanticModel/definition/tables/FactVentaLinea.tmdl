table FactVentaLinea
	lineageTag: 10cf5ccc-0fcb-55b4-b435-bf70544aee73

	measure 'Venta comercial' = SUM(FactVentaLinea[NetoPENFirmado])
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: c525a86e-aa40-5080-93ec-189812eb3ed8

	measure Facturación = CALCULATE([Venta comercial],FactVentaLinea[Tipo]="Factura")
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: e7e6bcc2-1e5c-53a7-b42a-f3d09e3e9732

	measure Devoluciones = -CALCULATE([Venta comercial],FactVentaLinea[Tipo]="Devolución")
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: 6d90397e-7af8-5ca3-a44b-6b6f32c4ea54

	measure 'Descuentos por nota' = -CALCULATE([Venta comercial],FactVentaLinea[Tipo]="Descuento")
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: 5d4e878f-7aca-56fb-a1bb-75cd17f47ab4

	measure 'Notas de crédito' = [Devoluciones]+[Descuentos por nota]
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: 0f94e362-a022-5688-a57b-f8207682b05a

	measure 'Notas sobre ventas anteriores' = -CALCULATE([Venta comercial],FactVentaLinea[Tipo]<>"Factura",FactVentaLinea[OrigenNota] IN {"Ventas de meses anteriores","Anterior a historia; sin factura cargada"})
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: 5577d9ab-8741-5320-9d0d-826a0bfcaaa3

	measure 'Notas sin origen identificado' = -CALCULATE([Venta comercial],FactVentaLinea[OrigenNota]="Origen no identificado")
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: ddf746ea-f5e3-561d-a8c0-3384dd46b1d2

	measure 'Ajustes de cierre' = IF(ISCROSSFILTERED(DimCliente) || ISCROSSFILTERED(DimProducto) || ISCROSSFILTERED(DimDocumento) || ISCROSSFILTERED(DimVendedor) || ISCROSSFILTERED(DimZonaComercial) || ISCROSSFILTERED(DimRegionAtencion),BLANK(),CALCULATE(SUM(FactAjusteCierre[ImportePEN]),KEEPFILTERS(TREATAS(VALUES(DimFecha[MesKey]),DimMes[MesKey]))))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: c827beca-eac9-5944-97b9-a3c77082ec82

	measure 'Venta neta' =
			VAR v=[Venta comercial]
			RETURN IF(ISBLANK(v),BLANK(),v+COALESCE([Ajustes de cierre],0))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: e8e29503-cb6c-5a14-9f84-c9571cf96f89

	measure 'Venta oficial empresa' = IF(ISCROSSFILTERED(DimCliente) || ISCROSSFILTERED(DimProducto) || ISCROSSFILTERED(DimDocumento) || ISCROSSFILTERED(DimVendedor) || ISCROSSFILTERED(DimZonaComercial) || ISCROSSFILTERED(DimRegionAtencion),BLANK(),[Venta neta])
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 01 Ventas
		lineageTag: 295dd87f-be2d-5d3d-8dea-4ffd0667d581

	measure 'Documentos fiscales' = DISTINCTCOUNT(FactVentaLinea[DocumentoKey])
		formatString: #,0
		displayFolder: 05 Trazabilidad
		lineageTag: 4428e8cf-8d39-5302-b333-8f9f652fa243

	measure 'Residuo de redondeo' = DIVIDE(SUM(FactVentaLinea[ResiduoCentimos]),100)
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 05 Trazabilidad
		lineageTag: 6c74d553-24df-5133-930e-737472556d85

	measure 'Meta vigente' = IF(ISCROSSFILTERED(DimCliente) || ISCROSSFILTERED(DimProducto) || ISCROSSFILTERED(DimDocumento),BLANK(),CALCULATE(SUM(FactMetaVersion[MetaPEN]),FactMetaVersion[EsVigente]=1,KEEPFILTERS(TREATAS(VALUES(DimFecha[MesKey]),DimMes[MesKey]))))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 02 Metas
		lineageTag: a5410d97-e210-59bf-a1eb-76a1a82a45d3

	measure 'Meta original' = IF(ISCROSSFILTERED(DimCliente) || ISCROSSFILTERED(DimProducto) || ISCROSSFILTERED(DimDocumento),BLANK(),CALCULATE(SUM(FactMetaVersion[MetaPEN]),FactMetaVersion[EsOriginal]=1,KEEPFILTERS(TREATAS(VALUES(DimFecha[MesKey]),DimMes[MesKey]))))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 02 Metas
		lineageTag: cf193b80-8214-5a7b-b58f-b9342372bc2e

	measure Cumplimiento = DIVIDE([Venta neta],[Meta vigente])
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: 1be4157f-7620-5f49-9877-091f04dc3cef

	measure 'Faltante a meta' =
			VAR m=[Meta vigente]
			VAR v=[Venta neta]
			RETURN IF(ISBLANK(m)||ISBLANK(v),BLANK(),MAX(0,m-v))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 02 Metas
		lineageTag: 7972e87f-7a32-5ade-bce1-134ce98d61e9

	measure 'Venta año anterior comparable' =
			VAR fechas=CALCULATETABLE(VALUES(DimFecha[Fecha]),DimFecha[Disponible]=1,TREATAS(VALUES(DimMes[MesKey]),DimFecha[MesKey]))
			VAR previas=DISTINCT(SELECTCOLUMNS(fechas,"FechaAnterior",EDATE(DimFecha[Fecha],-12)))
			RETURN IF(COUNTROWS(fechas)=0 || MINX(previas,[FechaAnterior])<DATE(2024,1,1),BLANK(),CALCULATE([Venta neta],REMOVEFILTERS(DimFecha),REMOVEFILTERS(DimMes),TREATAS(previas,DimFecha[Fecha])))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 03 Comparación
		lineageTag: 9d7ea991-ca2b-5bb9-9af8-4bd9433f7049

	measure 'Variación interanual' =
			VAR actual=[Venta neta]
			VAR previa=[Venta año anterior comparable]
			RETURN IF(ISBLANK(actual)||ISBLANK(previa),BLANK(),DIVIDE(actual-previa,previa))
		formatString: 0.0%
		displayFolder: 03 Comparación
		lineageTag: b15f473c-7844-5015-b27d-34bc553c3ed5

	measure 'Venta año anterior mes completo' =
			VAR meses=SELECTCOLUMNS(VALUES(DimMes[MesKey]),"MesAnterior",DimMes[MesKey]-100)
			RETURN CALCULATE([Venta neta],REMOVEFILTERS(DimFecha),REMOVEFILTERS(DimMes),TREATAS(meses,DimMes[MesKey]))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 03 Comparación
		lineageTag: d16b7656-3a13-5143-bde6-4123bf855591

	measure 'Días hábiles del mes' = IF(HASONEVALUE(DimMes[MesKey]),CALCULATE(SUM(DimFecha[Habil]),REMOVEFILTERS(DimFecha),TREATAS(VALUES(DimMes[MesKey]),DimFecha[MesKey])),BLANK())
		formatString: 0
		displayFolder: 02 Metas
		lineageTag: 7c02834a-1986-5ddb-a7d8-342a9825d2da

	measure 'Días hábiles transcurridos' = IF(HASONEVALUE(DimMes[MesKey]),CALCULATE(SUM(DimFecha[Habil]),REMOVEFILTERS(DimFecha),DimFecha[Disponible]=1,TREATAS(VALUES(DimMes[MesKey]),DimFecha[MesKey])),BLANK())
		formatString: 0
		displayFolder: 02 Metas
		lineageTag: efe5806f-e7da-5f24-b187-3beb194cc60a

	measure 'Días hábiles restantes' =
			VAR total=[Días hábiles del mes]
			RETURN IF(ISBLANK(total),BLANK(),MAX(0,total-[Días hábiles transcurridos]))
		formatString: 0
		displayFolder: 02 Metas
		lineageTag: 5cde6386-8c80-5554-9dd4-f082924e8109

	measure 'Faltante por día hábil' = DIVIDE([Faltante a meta],[Días hábiles restantes])
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 02 Metas
		lineageTag: d27985d7-eff9-5aa5-a765-dd3f652b2d12

	measure 'Venta diaria por hábil' = DIVIDE([Venta neta],[Días hábiles transcurridos])
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 02 Metas
		lineageTag: 1cba1368-10a9-5f84-82c0-49bc592ee634

	measure 'Avance esperado' = DIVIDE([Días hábiles transcurridos],[Días hábiles del mes])
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: ef156c60-0272-5127-8f0b-28d0b107331f

	measure Revisar =
			VAR c=[Cumplimiento]
			VAR e=[Avance esperado]
			RETURN IF(ISBLANK(c)||ISBLANK(e),BLANK(),IF(c<e-0.05,1,0))
		formatString: 0
		displayFolder: 02 Metas
		lineageTag: b785369d-048c-5cd6-8b53-f8c12a497217

	measure 'Pendiente confirmado' = IF(HASONEVALUE(DimCorte[CorteKey]),ROUND(SUM(FactPendienteLinea[SaldoPEN]),2),BLANK())
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 04 Pendiente
		lineageTag: 7a6b7eb2-edc8-5336-ace8-bf575cadf408

	measure 'Facturable este mes' = CALCULATE([Pendiente confirmado],KEEPFILTERS(FactPendienteLinea[GrupoKey]=6))
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 04 Pendiente
		lineageTag: b8621c90-cedb-560e-a33b-9ed752c18b0b

	measure 'Facturable pendiente de picking' = CALCULATE([Facturable este mes],FactPendienteLinea[FlagPicking]=1)
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 04 Pendiente
		lineageTag: 77a4b503-0466-58ed-bbf1-6ba7722b606d

	measure 'Facturado más pendiente confirmado' =
			VAR v=[Venta neta]
			VAR p=[Pendiente confirmado]
			RETURN IF(ISBLANK(v)||ISBLANK(p),BLANK(),v+p)
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 04 Pendiente
		lineageTag: d6fbb805-3396-509c-9700-25c735b90de5

	measure 'Avance permitido venta' = IF(HASONEVALUE(DimCorte[CorteKey]),SUM(FactAvancePermitido[VentaPEN]),BLANK())
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 06 Avance sin detalle
		lineageTag: 7d2ed146-92f9-5353-b780-9578be2a07e2

	measure 'Avance permitido meta' = IF(HASONEVALUE(DimCorte[CorteKey]),SUM(FactAvancePermitido[MetaVigentePEN]),BLANK())
		formatString: "S/ "#,0.00;("S/ "#,0.00);"S/ "0.00
		displayFolder: 06 Avance sin detalle
		lineageTag: bb7cf308-f926-5494-ba62-d701578bc57e

	measure 'Avance permitido cumplimiento' = DIVIDE([Avance permitido venta],[Avance permitido meta])
		formatString: 0.0%
		displayFolder: 06 Avance sin detalle
		lineageTag: 85cc49a8-9598-58af-a2eb-8b3db365c2be

