	partition FactVentaLinea = m
		mode: import
		source = Table.TransformColumnTypes(Stage[FactVentaLinea],{{"DocumentoKey", type text}, {"LineNum", Int64.Type}, {"FechaKey", Int64.Type}, {"MesKey", Int64.Type}, {"ClienteKey", type text}, {"ProductoKey", type text}, {"VendedorKey", Int64.Type}, {"ZonaKey", type text}, {"RegionKey", type text}, {"NetoPENFirmado", Currency.Type}, {"CantidadFirmada", type number}, {"ResiduoCentimos", Int64.Type}, {"Tipo", type text}, {"Folio", type text}, {"DocDate", type datetime}, {"CreateDate", type datetime}, {"Reconocimiento", type datetime}, {"FechaPedido", type datetime}, {"FuenteAtribucion", type text}, {"OrigenNC", type text}, {"OriginalInvoiceDate", type datetime}, {"Price", Currency.Type}, {"LineDiscPrcnt", type number}, {"DiscPrcnt", type number}, {"DocCur", type text}, {"DocRate", type number}, {"U_Canal", type text}, {"OrderEntry", Int64.Type}, {"OrigenNota", type text}, {"ReferenciaNC", type text}},"en-US")

